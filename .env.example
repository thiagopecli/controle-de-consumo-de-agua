# =============================
# AMBIENTE LOCAL (DESENVOLVIMENTO)
# =============================
# Copie este arquivo para .env e preencha os valores.
# Nao use valores de producao no ambiente local.

# Django
DEBUG=True
SECRET_KEY=trocar-por-chave-local-forte
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Banco de dados
# Opcao 1: PostgreSQL local
DB_NAME=controle_agua
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# Opcao 2: URL unica
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/controle_agua

# Sessao/seguranca local
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Base da aplicacao
APP_BASE_URL=http://127.0.0.1:8000

# Job interno
JOB_SECRET_TOKEN=trocar-por-token-local

# Z-API
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_WHATSAPP_TO=
ZAPI_AUTO_RECOVER_ON_SEND=true
ZAPI_RECONNECT_ATTEMPTS=2
ZAPI_RECONNECT_WAIT_SECONDS=3
ZAPI_WEBHOOK_SECRET=trocar-por-segredo-local

# Email SMTP para envio dos relatorios
# Use uma conta dedicada ao sistema, nao a sua conta pessoal.
# Em Gmail, gere uma senha de app e use-a em EMAIL_HOST_PASSWORD.
DEFAULT_FROM_EMAIL=relatorios@seudominio.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=relatorios@seudominio.com
EMAIL_HOST_PASSWORD=trocar-por-senha-de-app-ou-secret
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
